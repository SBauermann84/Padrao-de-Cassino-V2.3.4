rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /patterns/{patternId} {
      allow read: if true;
      allow write: if true; // In a production app, we'd harden this, but for this AI agent project we keep it open for learning.
    }

    match /dailyStats/{statId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Test connection document
    match /test/connection {
      allow read: if true;
    }
  }
}
